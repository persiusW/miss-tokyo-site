      "source": "/product-page/:slug*",
      "destination": "/products/:slug*",
      "statusCode": 308,
      "regex": "^(?!/_next)/product-page(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/category/:slug",
      "destination": "/shop?category=:slug",
      "statusCode": 308,
      "regex": "^(?!/_next)/category(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/accessibility-statement",
