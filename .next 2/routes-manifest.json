    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/shop/sale",
      "destination": "/shop?sale=true",
      "statusCode": 308,
      "regex": "^(?!/_next)/shop/sale(?:/)?$"
    },
    {
      "source": "/shop/new-arrivals",
      "destination": "/shop?sort=newest",
      "statusCode": 308,
      "regex": "^(?!/_next)/shop/new-arrivals(?:/)?$"
    },
    {
      "source": "/new-arrivals",
