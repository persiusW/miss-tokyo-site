{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon\\.ico|sitemap\\.xml|robots\\.txt|.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico|woff2?|ttf|otf|mp4|mov)).*))(\\.json)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon\\.ico|sitemap\\.xml|robots\\.txt|.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico|woff2?|ttf|otf|mp4|mov)).*)"
        }
      ]
    },
    "/api/cron/abandoned-cart": {},
    "/api/cron/sync-payment-status": {
      "maxDuration": 300
    },
    "/api/paystack/initialize": {
      "maxDuration": 30
    },
    "/api/paystack/webhook": {
      "maxDuration": 60
    },
    "/api/pos/send-link": {
      "maxDuration": 30
    }
  }
}